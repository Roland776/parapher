# ─── .env PRODUCTION (Render) — NE JAMAIS COMMITER CE FICHIER ────────────────
# Ces variables se règlent dans le dashboard Render (Environment), pas dans
# un fichier .env sur le serveur. Ce fichier sert de référence.

# Clé secrète Django — OBLIGATOIRE : générer une nouvelle clé unique
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=REMPLACER_PAR_UNE_VRAIE_CLE_GENEREE

# Base de données — URL de connexion Neon (PostgreSQL gratuit permanent)
# Récupérée dans le dashboard Neon > Connection string
# Format : postgresql://user:password@ep-xxx.neon.tech/parapheur_db?sslmode=require
DATABASE_URL=REMPLACER_PAR_URL_NEON

# Stockage des fichiers médias (PDF) — URL Cloudinary
# Récupérée dans le dashboard Cloudinary > Account Details > API Environment variable
# Format : cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_URL=REMPLACER_PAR_URL_CLOUDINARY

# IMPORTANT : False en production
DEBUG=False

# Hôtes autorisés — ajoutez votre domaine Render (RENDER_EXTERNAL_HOSTNAME
# est ajouté automatiquement par settings.py, inutile de le dupliquer ici)
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — URL du frontend (Vercel/Netlify)
CORS_EXTRA_ORIGINS=https://votre-frontend.vercel.app

# URL du frontend (pour les liens dans les e-mails)
FRONTEND_URL=https://votre-frontend.vercel.app

# ── E-mail ────────────────────────────────────────────────────────────────────
# EMAIL_BACKEND absent (ou commenté) = smtp.EmailBackend par défaut = emails envoyés
# NE PAS mettre EMAIL_BACKEND=console en production
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend  ← dev uniquement

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-adresse@gmail.com
# Mot de passe d'application Gmail (pas votre vrai mot de passe)
# Générer sur : https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
